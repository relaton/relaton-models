enum BsiDocumentType {
  british-standard {
    definition {
      British Standard.
    }
  }
  draft-for-development {
    definition {
      Draft for Development.
    }
  }
  european-workshop-agreement {
    definition {
      European Workshop Agreement (adopted from CEN, CENELEC).
    }
  }
  expert-commentary {
    definition {
      Expert Commentary (on another document).
    }
  }
  fast-track-standard {
    definition {
      Fast track standard document type.
    }
  }
  flex-standard {
    definition {
      Flex Standard.
    }
  }
  guide {
    definition {
      Guide.
    }
  }
  industry-technical-agreement {
    definition {
      Industry Technical Agreement (adopted from IEC).
    }
  }
  international-standard {
    definition {
      International Standard (adopted from ISO, IEC).
    }
  }
  international-workshop-agreement {
    definition {
      International Workshop Agreement (adopted from ISO, IEC).
    }
  }
  privately-subscribed-standard {
    definition {
      Privately Subscribed Standard.
    }
  }
  publicly-available-specification {
    definition {
      Publicly Available Specification.
    }
  }
  published-document {
    definition {
      Published Document.
    }
  }
  standard {
    definition {
      Standard (adopted from CEN, CENELEC).
    }
  }
  technical-report {
    definition {
      Technical Report.
    }
  }
  technical-specification {
    definition {
      Technical Specification.
    }
  }
}
