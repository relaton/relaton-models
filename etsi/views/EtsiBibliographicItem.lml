diagram EtsiBibliographicItem {
  title 'ETSI Bibliographic Item'

  include ../../relaton/models/BibliographicItem.lml
  include ../models/EtsiBibliographicItem.lml
  include ../models/EtsiDocumentType.lml
  include ../models/EtsiDocumentTypeAbbreviation.lml
  include ../models/EtsiStageType.lml
  include ../models/EtsiMarker.lml
  include ../models/EtsiCustomCollection.lml
  include ../models/EtsiBibDataExtensionType.lml

  association {
    owner BibliographicItem
    member EtsiBibliographicItem
    owner_type inheritance
  }
  association {
    owner EtsiBibliographicItem
    member EtsiDocumentType
    owner_type direct
  }
  association {
    owner EtsiBibliographicItem
    member EtsiDocumentTypeAbbreviation
    owner_type direct
  }
  association {
    owner EtsiBibliographicItem
    member EtsiBibDataExtensionType
    owner_type direct
  }
  association {
    owner EtsiBibDataExtensionType
    member EtsiStageType
    owner_type direct
  }
  association {
    owner EtsiBibDataExtensionType
    member EtsiMarker
    owner_type direct
  }
  association {
    owner EtsiBibDataExtensionType
    member EtsiCustomCollection
    owner_type direct
  }
}
