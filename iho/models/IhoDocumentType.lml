enum IhoDocumentType {
  definition {
    standard (framework document, e.g. S-57, S-100), specification
    (implementation of framework, e.g. S-101, S-111), resolutions (e.g. M-3),
    regulations (e.g. S-4, M-7).
  }
  standard
  specification
  resolutions
  regulations
  best-practices {
    definition {
      Best practices document type.
    }
  }

  directives {
    definition {
      Directives document type.
    }
  }

  legal {
    definition {
      Legal document type.
    }
  }

  policy-and-procedures {
    definition {
      Policy and procedures document type.
    }
  }

  proposal {
    definition {
      Proposal document type.
    }
  }

  regulation {
    definition {
      Regulation document type.
    }
  }

  report {
    definition {
      Report document type.
    }
  }

  resolution {
    definition {
      Resolution document type.
    }
  }

  specification {
    definition {
      Specification document type.
    }
  }

  standard {
    definition {
      Standard document type.
    }
  }

  supporting-document {
    definition {
      Supporting document document type.
    }
  }

}
