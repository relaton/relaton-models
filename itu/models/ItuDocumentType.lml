enum ItuDocumentType {
  definition {
    ITU-T Recommendation, Supplement to Recommendation, Amendment to
    Recommendation, Corrigendum to Recommendation, Errata to Recommendation,
    Annex to Recommendation, Resolution, Focus Group document, ITU-T / ISO/IEC
    document, Implementers' Guide, Technical Paper, Technical Report,
    Service Publication.
  }
  recommendation
  recommendation-supplement
  recommendation-amendment
  recommendation-corrigendum
  recommendation-errata
  recommendation-annex
  resolution
  focus-group
  implementers-guide
  technical-paper
  technical-report
  joint-itu-iso-iec
  service-publication
  handbook {
    definition {
      ITU handbook.
    }
  }
  question {
    definition {
      ITU study question.
    }
  }
  contribution {
    definition {
      ITU contribution document.
    }
  }
  focus-group {
    definition {
      Focus group document type.
    }
  }

  implementers-guide {
    definition {
      Implementers guide document type.
    }
  }

  joint-itu-iso-iec {
    definition {
      Joint itu iso iec document type.
    }
  }

  recommendation {
    definition {
      Recommendation document type.
    }
  }

  recommendation-amendment {
    definition {
      Recommendation amendment document type.
    }
  }

  recommendation-annex {
    definition {
      Recommendation annex document type.
    }
  }

  recommendation-corrigendum {
    definition {
      Recommendation corrigendum document type.
    }
  }

  recommendation-errata {
    definition {
      Recommendation errata document type.
    }
  }

  recommendation-supplement {
    definition {
      Recommendation supplement document type.
    }
  }

  resolution {
    definition {
      Resolution document type.
    }
  }

  service-publication {
    definition {
      Service publication document type.
    }
  }

  technical-paper {
    definition {
      Technical paper document type.
    }
  }

  technical-report {
    definition {
      Technical report document type.
    }
  }

}
