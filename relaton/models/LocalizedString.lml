class LocalizedString {
  definition {
    FormattedString which optionally specifies its language, locale, script,
    and script-conversion spelling system.
  }
  +language: Iso639Code[0..*] {
    definition {
      Language of string.
    }
  }
  +locale: Iso3166Code[0..*] {
    definition {
      Locale of string.
    }
  }
  +script: Iso15924Code[0..*] {
    definition {
      Script of string.
    }
  }
  +spellingSystem: Iso24229Code[0..*] {
    definition {
      Script-conversion (spelling) system codes per ISO 24229, distinguishing
      the conversion method from language and script.
    }
  }
  +content: String  {
    definition {
      The string being localized.
    }
  }
}
