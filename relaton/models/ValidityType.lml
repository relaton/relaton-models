class ValidityType {
  definition {
    The time interval for which a bibliographic item
    is determined valid, and the associated revision date.
  }
  +validityBegins: Iso8601DateTime[0..1] {
    definition {
      The date and time when this bibliographic item becomes valid.
    }
  }
  +validityEnds: Iso8601DateTime[0..1] {
    definition {
      The date and time when this bibliographic item becomes invalid.
    }
  }
  +revision: Iso8601DateTime[0..1] {
    definition {
      The date and time of issuance of the version of the document
      for which this claim of validity is made, if applicable.
    }
  }

  +provenance: <<Basicdoc>>BasicElement[0..*] {
    definition {
      Chain of custody for the cited resource, per ISO 690 clause 7.15.
    }
  }
  +authenticity: AuthenticityStatus[0..1] {
    definition {
      Whether the cited resource is certified, a copy, or of unknown
      authenticity, per ISO 690 clause 7.15.
    }
  }
}
