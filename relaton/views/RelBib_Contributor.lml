diagram RelBib_Contributor {

  include ../models/Contributor.lml
  include ../models/Person.lml
  include ../models/ContactMethod.lml
  include ../models/Phone.lml
  include ../models/Organization.lml
  include ../models/OrgSubdivision.lml
  include ../models/VariantOrgName.lml
  include ../models/Address.lml
  include ../models/PersonIdentifier.lml
  include ../models/Affiliation.lml
  include ../models/OrgIdentifier.lml
  include ../models/FullName.lml
  include ../models/Forename.lml
  include ../models/VariantFullName.lml

  association {
    owner Contributor
    member Person
    owner_type inheritance
  }
  association {
    owner Contributor
    member Organization
    owner_type inheritance
  }
  association {
    owner Organization
    member OrgSubdivision
    owner_type inheritance
  }
  association {
    owner Organization
    member OrgSubdivision
    owner_type direct
  }
  association {
    owner Organization
    member OrgIdentifier
    owner_type direct
  }
  association {
    owner Organization
    member ContactMethod
    owner_type direct
  }
  association {
    owner ContactMethod
    member Person
    member_type direct
  }
  association {
    owner Person
    member PersonIdentifier
    owner_type direct
  }
  association {
    owner Person
    member Affiliation
    owner_type direct
  }
  association {
    owner Affiliation
    member Organization
    member_type direct
  }
  association {
    owner ContactMethod
    member Address
    owner_type direct
  }
  association {
    owner ContactMethod
    member Phone
    owner_type direct
  }
  association {
    owner Person
    member FullName
    owner_type direct
  }
  association {
    owner FullName
    member Forename
    owner_type direct
  }
  association {
    owner Organization
    member VariantOrgName
    owner_type direct
  }
  association {
    owner OrgIdentifier
    member OrgIdentifier
    owner_type direct
  }
  association {
    owner FullName
    member VariantFullName
    owner_type direct
  }
}
